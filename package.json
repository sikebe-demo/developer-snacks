{
  "name": "developer-snacks",
  "version": "1.0.0",
  "description": "A web application showcasing data visualizations with Chart.js",
  "scripts": {
    "serve": "live-server --port=8080 --open=/",
    "lint": "npm run lint:js && npm run lint:html",
    "lint:js": "eslint .",
    "lint:html": "htmlhint **/*.html",
    "format": "prettier --write \"**/*.{js,json,html,css,md}\"",
    "format:check": "prettier --check \"**/*.{js,json,html,css,md}\""
  },
  "keywords": [
    "chart",
    "visualization",
    "dashboard",
    "web"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "htmlhint": "^1.1.4",
    "live-server": "^1.2.2",
    "prettier": "^3.2.5"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
